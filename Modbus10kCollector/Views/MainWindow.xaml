<Window x:Class="Modbus10kCollector.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 按钮区域 -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 10">
            <Button Content="启动采集" Command="{Binding StartCollectCommand}" Width="100" Margin="0 0 10 0"/>
            <Button Content="停止采集" Command="{Binding StopCollectCommand}" Width="100" Margin="0 0 10 0"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="20 0"/>
        </StackPanel>

        <!-- PLC设备列表 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding DeviceItems}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceId}"/>
                <DataGridTextColumn Header="IP地址" Binding="{Binding Ip}"/>
                <DataGridTextColumn Header="端口" Binding="{Binding Port}"/>
                <DataGridTextColumn Header="当前状态" Binding="{Binding CurrentState}"/>
                <DataGridTextColumn Header="连续失败" Binding="{Binding ContinuousFailCount}"/>
                <DataGridTextColumn Header="最后成功时间" Binding="{Binding LastSuccessTime}"/>
                <DataGridTextColumn Header="冷却结束时间" Binding="{Binding BreakCoolEndTime}" />
                <DataGridTemplateColumn Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="重置" Command="{Binding DataContext.ResetPlcCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding .}" Width="60"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
